# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo del lado del servidor. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OPCIONAL. Claude (console.anthropic.com) lee la factura y arma la estrategia.
# Si no la cargás, las facturas van directo a tu panel /admin para gestionarlas a mano.
# ANTHROPIC_API_KEY=sk-ant-...

# Avisos por email (resend.com, gratis hasta 3.000 emails/mes).
# El email destino se configura en /admin/configuracion.
RESEND_API_KEY=re_...
# Opcional: remitente con tu dominio verificado en Resend. Sin dominio, usá el de prueba.
# EMAIL_REMITENTE=TuServicio <avisos@tudominio.com>
