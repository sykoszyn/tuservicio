# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo del lado del servidor. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OPCIONAL. Claude (console.anthropic.com) lee la factura y arma la estrategia.
# Si no la cargás, las facturas van directo a tu panel /admin para gestionarlas a mano.
# ANTHROPIC_API_KEY=sk-ant-...

# Aporte voluntario (opcional). Si no los completás, no se muestra el bloque de aporte.
NEXT_PUBLIC_MP_LINK=https://link.mercadopago.com.ar/tu-link
NEXT_PUBLIC_MP_ALIAS=tu.alias.mp
